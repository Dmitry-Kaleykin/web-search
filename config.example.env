# Required search endpoint
WEB_SEARCH_SEARXNG_URL=http://127.0.0.1:8080

# Optional direct model fallback for MCP clients without sampling support
WEB_SEARCH_MODEL_BASE_URL=http://127.0.0.1:8000/v1
WEB_SEARCH_MODEL_ID=

# Optional direct fallback authentication
WEB_SEARCH_MODEL_API_KEY=

# Optional dedicated evidence model. The terminal UI saves this selection automatically;
# environment variables override the saved selection for advanced deployments.
WEB_SEARCH_EVIDENCE_MODEL_BASE_URL=
WEB_SEARCH_EVIDENCE_MODEL_ID=
WEB_SEARCH_EVIDENCE_MODEL_API_KEY=
WEB_SEARCH_EVIDENCE_MODEL_TIMEOUT_SECONDS=90
WEB_SEARCH_EVIDENCE_MODEL_MAX_TOKENS=1600
WEB_SEARCH_EVIDENCE_MODEL_TEMPERATURE=0.1

# Optional semantic candidate reranker using the native POST /v1/rerank protocol.
# Base URL and API key inherit the direct model endpoint when left empty.
WEB_SEARCH_RERANKER_BASE_URL=
WEB_SEARCH_RERANKER_MODEL_ID=
WEB_SEARCH_RERANKER_API_KEY=
WEB_SEARCH_RERANKER_TIMEOUT_SECONDS=30
WEB_SEARCH_RERANKER_MAX_CANDIDATES=24
# Page eligibility gate. The floor relaxes after wholly irrelevant search batches.
WEB_SEARCH_RERANKER_MIN_RELEVANCE_SCORE=0.08
# Also discard candidates far below the best result in the current batch.
WEB_SEARCH_RERANKER_RELATIVE_RELEVANCE_RATIO=0.15
# Conservative fallback used only when semantic reranking is unavailable.
WEB_SEARCH_LEXICAL_MIN_RELEVANCE_SCORE=0.01

# Concurrent page retrieval window. Model-based evidence extraction remains sequential.
WEB_SEARCH_PREFETCH_PAGES=2

# Runtime
WEB_SEARCH_DATA_DIR=.web-search-data
WEB_SEARCH_LOG_LEVEL=INFO
WEB_SEARCH_USER_AGENT="LocalResearchBot/0.1 (+local personal research)"

# Reader safety and cache
WEB_SEARCH_ALLOW_PRIVATE_URLS=false
# Allow only RFC 2544 synthetic DNS addresses used by local TUN/fake-IP proxies.
# Literal 198.18.0.0/15 URLs and all other private ranges remain blocked.
WEB_SEARCH_ALLOW_PROXY_FAKE_IPS=false
WEB_SEARCH_MAX_RESPONSE_BYTES=5000000
WEB_SEARCH_DOCUMENT_CACHE_TTL_SECONDS=21600
WEB_SEARCH_SEARCH_CACHE_TTL_SECONDS=900
WEB_SEARCH_ENABLE_CRAWL4AI=true
# Upper bounds for direct read_url output. The tool defaults to smaller pageable content chunks.
WEB_SEARCH_READ_URL_MAX_CHARS=60000
WEB_SEARCH_READ_URL_MAX_LINKS=100
CRAWL4_AI_BASE_DIRECTORY=.web-search-data
PLAYWRIGHT_BROWSERS_PATH=.web-search-data/ms-playwright

# Individual model-call behavior. Effort modes also impose a total wall-clock deadline.
WEB_SEARCH_MODEL_TIMEOUT_SECONDS=90
WEB_SEARCH_MODEL_MAX_TOKENS=4096
WEB_SEARCH_MODEL_TEMPERATURE=0.1
