# Required search endpoint
WEB_SEARCH_SEARXNG_URL=http://127.0.0.1:8080

# Runtime
WEB_SEARCH_DATA_DIR=.web-search-data
WEB_SEARCH_LOG_LEVEL=INFO
WEB_SEARCH_USER_AGENT="LocalResearchBot/0.1 (+local personal research)"

# Reader safety and cache
WEB_SEARCH_ALLOW_PRIVATE_URLS=false
# Allow only RFC 2544 synthetic DNS addresses used by local TUN/fake-IP proxies.
# Literal 198.18.0.0/15 URLs and all other private ranges remain blocked.
WEB_SEARCH_ALLOW_PROXY_FAKE_IPS=false
WEB_SEARCH_MAX_RESPONSE_BYTES=5000000
WEB_SEARCH_DOCUMENT_CACHE_TTL_SECONDS=21600
WEB_SEARCH_SEARCH_CACHE_TTL_SECONDS=900
WEB_SEARCH_ENABLE_CRAWL4AI=true
# Upper bounds for direct read_url output. The tool defaults to smaller pageable content chunks.
WEB_SEARCH_READ_URL_MAX_CHARS=60000
WEB_SEARCH_READ_URL_MAX_LINKS=100
CRAWL4_AI_BASE_DIRECTORY=.web-search-data
PLAYWRIGHT_BROWSERS_PATH=.web-search-data/ms-playwright

# One search request per tool call. The deadline includes dispatch queue time.
WEB_SEARCH_SEARCH_TIMEOUT_SECONDS=30
# General-web engines to query, excluding any with active persisted cooldowns.
# Match this list to enabled engines on your SearXNG instance.
WEB_SEARCH_SEARCH_HEALTHY_ENGINES=google cse,duckduckgo web,mwmbl,searchmysite,mojeek,crowdview

# Document and cache ceilings. read_url_max_chars bounds tool OUTPUT only; these bound what is
# stored. Without them a single rendered page can dominate the database (one was measured at
# 16.3 MB against a 60k output limit) and the cache never shrinks.
# Larger than one inline chunk so callers can continue reading the extracted document.
WEB_SEARCH_DOCUMENT_MAX_CHARS=1000000
# Row ceilings enforced on write (amortised) and by web-search-maint.
WEB_SEARCH_CACHE_SEARCH_MAX_ROWS=2000
WEB_SEARCH_CACHE_DOCUMENT_MAX_ROWS=400
# Fresh rows larger than this are evicted too; structured JSON is never character-truncated,
# so this is the ceiling that bounds .json resources.
WEB_SEARCH_CACHE_DOCUMENT_MAX_PAYLOAD_BYTES=2000000
# Concurrent Chromium renders across callers. Use 1 on memory-constrained machines.
WEB_SEARCH_BROWSER_MAX_CONCURRENT_RENDERS=2
