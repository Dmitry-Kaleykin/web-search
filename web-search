#!/bin/sh
set -eu

LAUNCHER=$0
while [ -L "$LAUNCHER" ]; do
  LAUNCHER_DIR=$(CDPATH= cd -- "$(dirname -- "$LAUNCHER")" && pwd)
  LINK_TARGET=$(readlink "$LAUNCHER")
  case "$LINK_TARGET" in
    /*) LAUNCHER=$LINK_TARGET ;;
    *) LAUNCHER=$LAUNCHER_DIR/$LINK_TARGET ;;
  esac
done

PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$LAUNCHER")" && pwd)
UI_DIR="$PROJECT_DIR/ui"

if ! command -v node >/dev/null 2>&1; then
  echo "Node.js 22.19 or newer is required for the terminal console." >&2
  exit 1
fi

if [ ! -d "$UI_DIR/node_modules/@earendil-works/pi-tui" ]; then
  echo "Installing terminal console dependencies..."
  npm install --prefix "$UI_DIR" --no-audit --no-fund
fi

exec node "$UI_DIR/src/app.js" "$@"
